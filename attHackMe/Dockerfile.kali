# Dockerfile.kali

FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive
ENV USER=root

# Ajout des dépôts, MAJ et installation des outils
RUN echo "deb http://http.kali.org/kali kali-rolling main non-free contrib" > /etc/apt/sources.list && \
    apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y \
        kali-linux-default \
        xfce4 xfce4-goodies \
        tightvncserver \
        dbus-x11 \
        x11-xserver-utils \
        firefox-esr \
        burpsuite \
        wireshark \
        gobuster \
        hydra \
        sqlmap \
        john \
        net-tools iproute2 \
        sudo \
        curl wget \
        openssh-server \
        xauth && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Configuration de root, SSH, et VNC
RUN echo "root:toor" | chpasswd && \
    mkdir -p /var/run/sshd && \
    sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config

RUN mkdir -p /root/.vnc && \
    echo -e "#!/bin/bash\nxrdb \$HOME/.Xresources\nstartxfce4 &" > /root/.vnc/xstartup && \
    chmod +x /root/.vnc/xstartup && \
    echo "toor" | vncpasswd -f > /root/.vnc/passwd && \
    chmod 600 /root/.vnc/passwd && \
    touch /root/.Xresources

# Script de démarrage propre qui gère les fichiers lock
RUN echo -e '#!/bin/bash\n\
if [ -f /tmp/.X1-lock ]; then\n\
    echo "Removing stale VNC lock file..."\n\
    rm -f /tmp/.X1-lock /tmp/.X11-unix/X1 /root/.vnc/*.pid\n\
fi\n\
vncserver :1 -geometry 1280x720 -depth 24\n\
/usr/sbin/sshd -D' > /start.sh && chmod +x /start.sh

EXPOSE 22
EXPOSE 5901

COPY start.sh /start.sh
RUN chmod +x /start.sh
CMD ["/start.sh"]
